# Copy this file to .env and fill in the values

PORT=5000

# MongoDB connection (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/feedback_platform

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend URL(s) allowed to call the API (comma separated).
# The public widget endpoint is always open to any website.
CLIENT_URL=http://localhost:5173

# Generative AI (Google Gemini, free tier available at https://aistudio.google.com/apikey)
# Leave GEMINI_API_KEY empty to use the built-in rule-based fallback instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
